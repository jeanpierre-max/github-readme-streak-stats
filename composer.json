{
  "name": "jeanpierre-max/github-readme-streak-stats",
  "description": "Muestra tu total de contribuciones, racha actual y racha más larga en el README de tu perfil de GitHub.",
  "keywords": [
    "github",
    "dynamic",
    "readme",
    "contributions",
    "streak",
    "stats"
  ],
  "license": "MIT",
  "version": "1.6.0",
  "autoload": {
    "classmap": [
      "src/"
    ]
  },
  "require": {
    "php": "^8.2",
    "ext-intl": "*",
    "vlucas/phpdotenv": "^5.3"
  },
  "require-dev": {
    "phpunit/phpunit": "^11"
  },
  "scripts": {
    "start": [
      "Composer\\Config::disableProcessTimeout",
      "php -S localhost:8000 -t src"
    ],
    "test": "./vendor/bin/phpunit --testdox tests",
    "lint": "pnpm exec prettier --check *.md **/*.{php,md,js,css}",
    "lint-fix": "pnpm exec prettier --write *.md **/*.{php,md,js,css}"
  }
}
