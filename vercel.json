{
  "builds": [
    {
      "src": "index.php",
      "use": "vercel-php@0.7.2"
    },
    {
      "src": "src/demo/index.php",
      "use": "vercel-php@0.7.2"
    },
    {
      "src": "src/demo/preview.php",
      "use": "vercel-php@0.7.2"
    }
  ],
  "routes": [
    {
      "src": "/demo(.*)",
      "dest": "/src/demo/index.php"
    },
    {
      "src": "/preview(.*)",
      "dest": "/src/demo/preview.php"
    },
    {
      "src": "/(.*)",
      "dest": "/index.php"
    }
  ]
}
